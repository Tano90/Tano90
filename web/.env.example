# Copy to .env.local and fill in. Never commit .env.local. Every value comes from an account YOU create.

# --- App
APP_URL=http://localhost:3000             # public URL, used in email links and Stripe redirects

# --- Database (Supabase -> Project Settings -> Database -> Connection string, "Session" pooler, port 5432)
# Without it the app runs on the in-memory demo store (development only).
DATABASE_URL=
DATABASE_POOL_MAX=5

# --- Supabase Auth (Project Settings -> API). Without these: demo login (development only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                 # server only: needed to delete accounts

# --- Email (resend.com -> API Keys; verify your sending domain first). Without: mails go to web/.outbox/
RESEND_API_KEY=
MAIL_FROM="Pantra <bestellung@your-domain.example>"

# --- Stripe, TEST MODE keys until /replica-deploy (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=                         # sk_test_...
STRIPE_PRICE_ID=                           # recurring per-outlet price, price_...
STRIPE_WEBHOOK_SECRET=                     # whsec_... (stripe listen --forward-to localhost:3000/api/webhooks/stripe)
STRIPE_AUTOMATIC_TAX=0                     # 1 once Stripe Tax is set up

# --- Jobs (Vercel Cron sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=                               # long random string, e.g. openssl rand -hex 32

# --- Local only
# ALLOW_DEMO=1                             # allow demo login + mail outbox in a production build (never on a real deployment)
# TEST_DATABASE_URL=                       # migrated + seeded Postgres for `npm test` integration tests
