{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glb-command-center-v11-staging",
  "compatibility_date": "2026-10-21",
  "main": "src/worker.mjs",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
