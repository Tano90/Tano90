{
 "_about": "Themes reviews.py sorts feedback into. Patterns are Python regular expressions, matched case-insensitively against the review text. kind is complaint (something users hate) or request (something users want that is missing). Edit freely: add the app category's own words (for a booking app: double booking, time zone, no-show). Extended for restaurant back-office software (recipes, costing, inventory, purchasing); patterns in English and German because reviews come from G2/Capterra (mostly English) and German sources.",
 "request_patterns": [
  "\\bi wish\\b",
  "\\bplease add\\b",
  "\\bwould be (nice|great|good|helpful)\\b",
  "\\bwould love\\b",
  "\\bneeds? (a|an|the|to|more)\\b",
  "\\bno way to\\b",
  "\\bthere'?s no (way|option)\\b",
  "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|import|customi[sz]e|connect|undo|delete|turn off)\\b",
  "\\b(missing|lacks|lacking)\\b",
  "\\bdoesn'?t (have|support|let|allow)\\b",
  "\\bif only\\b",
  "\\bfeature request\\b",
  "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
  "\\bich w(ü|ue)nsche\\b",
  "\\bes fehlt\\b",
  "\\bw(ä|ae)re (schön|toll|gut|hilfreich)\\b",
  "\\bleider (kein|keine|nicht)\\b",
  "\\bbitte (einbauen|hinzufügen)\\b"
 ],
